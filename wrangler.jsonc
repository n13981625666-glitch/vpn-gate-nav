{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vpn-gate-nav",
  "main": "src/index.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  // KV 不写 id：点击「Deploy to Cloudflare」时会自动创建并回填
  "kv_namespaces": [
    { "binding": "LINKS_KV" }
  ]
  // 可选环境变量（自定义域名重定向）：
  // "vars": { "APEX_DOMAIN": "example.com" }
}
